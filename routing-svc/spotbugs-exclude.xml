<?xml version="1.0" encoding="UTF-8"?>
<!-- Each exclusion says why. Spring injects collaborators through constructors and keeps them;
     SpotBugs reports that as exposing internal representation. -->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <!-- Bean constructors that validate config and may throw; Spring discards the half-built bean. -->
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>

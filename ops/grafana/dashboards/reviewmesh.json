{
  "title": "reviewmesh handoffs",
  "uid": "reviewmesh",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Queue depth", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "reviewmesh_queue_depth", "legendFormat": "{{queue}}"}]},
    {"type": "stat", "title": "Dead letters", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
     "targets": [{"expr": "sum(reviewmesh_queue_depth{queue=~\".*dlq\"})"}]},
    {"type": "stat", "title": "Stuck records", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
     "targets": [{"expr": "reviewmesh_records_stuck"}]},
    {"type": "timeseries", "title": "Records by status", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "reviewmesh_records_by_status", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "Worker events", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "rate(reviewmesh_worker_events_total[1m])", "legendFormat": "{{worker}} {{kind}}"}]},
    {"type": "timeseries", "title": "Routing latency p95 (Java)", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/v1/routing/decisions\"}[1m])))"}]}
  ]
}
